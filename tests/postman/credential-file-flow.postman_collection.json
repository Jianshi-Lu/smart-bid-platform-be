{
  "info": {
    "name": "smart-bid credential file full flow",
    "description": "验证从 original 上传、Java 从 MinIO 读取并 multipart 调用 Python、Java 上传和回读校验 converted、投标记录级 Markdown 汇总，到大模型统一风险分析和 risk_analysis 落库的完整链路。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "bidRecordId",
      "value": "1001"
    },
    {
      "key": "fileAPath",
      "value": "/absolute/path/to/license.pdf"
    },
    {
      "key": "fileBPath",
      "value": "/absolute/path/to/qualification.docx"
    },
    {
      "key": "uploadBatchId",
      "value": ""
    },
    {
      "key": "uploadedFileCount",
      "value": "0"
    },
    {
      "key": "analysisId",
      "value": ""
    },
    {
      "key": "mergedMarkdownPath",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Prerequisite",
      "item": [
        {
          "name": "确认 bid_record 存在",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bid-record/{{bidRecordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bid-record",
                "{{bidRecordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test('业务响应成功', function () {",
                  "    pm.expect(result.code).to.eql(200);",
                  "});",
                  "pm.test('返回目标 bidRecordId', function () {",
                  "    pm.expect(String(result.data.bidRecordId)).to.eql(String(pm.collectionVariables.get('bidRecordId')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Chain - upload original",
      "item": [
        {
          "name": "上传多个 original 文件",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "bidRecordId",
                  "value": "{{bidRecordId}}",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{fileAPath}}"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "{{fileBPath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/credential-files/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credential-files",
                "upload"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test('业务响应成功', function () {",
                  "    pm.expect(result.code).to.eql(200);",
                  "});",
                  "pm.test('返回 uploadBatchId', function () {",
                  "    pm.expect(result.data.uploadBatchId).to.be.a('string').and.not.empty;",
                  "});",
                  "const files = result.data.files || [];",
                  "pm.collectionVariables.set('uploadBatchId', result.data.uploadBatchId);",
                  "pm.collectionVariables.set('uploadedFileCount', String(files.length));",
                  "pm.test('至少上传一个文件', function () {",
                  "    pm.expect(files.length).to.be.above(0);",
                  "});",
                  "files.forEach(function (file, index) {",
                  "    pm.test('文件 ' + index + ' 已完成 original 持久化', function () {",
                  "        pm.expect(file.convertStatus).to.eql('UPLOADED');",
                  "        pm.expect(file.originalFilePath).to.include('bid-records/' + pm.collectionVariables.get('bidRecordId') + '/batches/');",
                  "        pm.expect(file.originalFilePath).to.include('/original/');",
                  "        pm.expect(file.originalFilePath).to.include(result.data.uploadBatchId + '/');",
                  "        pm.expect(file.originalFilePath).to.not.match(/^\\//);",
                  "        pm.expect(file.fileSize).to.be.above(0);",
                  "        pm.expect(file.sha256).to.match(/^[0-9a-f]{64}$/);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Chain - convert original to markdown",
      "item": [
        {
          "name": "按 bidRecordId 转换全部文件批次",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/credential-files/bid-records/{{bidRecordId}}/convert",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "credential-files",
                "bid-records",
                "{{bidRecordId}}",
                "convert"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test('业务响应成功', function () {",
                  "    pm.expect(result.code).to.eql(200);",
                  "});",
                  "const data = result.data;",
                  "pm.test('返回目标 bidRecordId', function () {",
                  "    pm.expect(String(data.bidRecordId)).to.eql(String(pm.collectionVariables.get('bidRecordId')));",
                  "});",
                  "pm.test('存在已转换批次', function () {",
                  "    pm.expect(data.totalBatchCount).to.be.above(0);",
                  "    pm.expect(data.convertedBatchCount).to.eql(data.totalBatchCount);",
                  "    pm.expect(data.failedBatchCount).to.eql(0);",
                  "    pm.expect(data.processingBatchCount).to.eql(0);",
                  "    pm.expect(data.status).to.eql('ALL_CONVERTED');",
                  "});",
                  "const uploadedBatch = (data.batches || []).find(function (batch) {",
                  "    return batch.uploadBatchId === pm.collectionVariables.get('uploadBatchId');",
                  "});",
                  "pm.test('刚上传的批次已被 bidRecordId 转换链处理', function () {",
                  "    pm.expect(uploadedBatch).to.exist;",
                  "    pm.expect(uploadedBatch.fileCount).to.eql(Number(pm.collectionVariables.get('uploadedFileCount')));",
                  "});",
                  "(data.batches || []).forEach(function (batch, index) {",
                  "    pm.test('批次 ' + index + ' 已完成转换', function () {",
                  "        pm.expect(batch.batchStatus).to.eql('CONVERTED');",
                  "        pm.expect(batch.fileCount).to.eql(batch.convertedFileCount);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "验证 bid_record.credentials 已回写 converted object key",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bid-record/{{bidRecordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bid-record",
                "{{bidRecordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "const credentials = result.data.credentials || [];",
                  "pm.test('credentials 已写入 Markdown object key', function () {",
                  "    pm.expect(credentials.length).to.be.at.least(Number(pm.collectionVariables.get('uploadedFileCount')));",
                  "    credentials.forEach(function (objectKey) {",
                  "        pm.expect(objectKey).to.include('/converted/');",
                  "        pm.expect(objectKey).to.match(/\\.md$/);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Chain - aggregate and analyze",
      "item": [
        {
          "name": "汇总 converted Markdown 并调用大模型",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bid-record/analyze-risk/{{bidRecordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bid-record",
                "analyze-risk",
                "{{bidRecordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test('风险分析业务响应成功', function () {",
                  "    pm.expect(result.code).to.eql(200);",
                  "});",
                  "const analysis = result.data;",
                  "pm.test('返回风险分析结果', function () {",
                  "    pm.expect(analysis).to.be.an('object');",
                  "    pm.expect(analysis.analysisId).to.exist;",
                  "    pm.expect(String(analysis.bidRecordId)).to.eql(String(pm.collectionVariables.get('bidRecordId')));",
                  "});",
                  "pm.collectionVariables.set('analysisId', String(analysis.analysisId));",
                  "pm.collectionVariables.set('mergedMarkdownPath', 'bid-records/' + pm.collectionVariables.get('bidRecordId') + '/merged/credentials.md');",
                  "pm.test('汇总 Markdown 目标路径符合约定', function () {",
                  "    pm.expect(pm.collectionVariables.get('mergedMarkdownPath')).to.eql('bid-records/' + pm.collectionVariables.get('bidRecordId') + '/merged/credentials.md');",
                  "});",
                  "pm.test('风险等级已返回', function () {",
                  "    pm.expect(['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']).to.include(analysis.riskLevel);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "验证 risk_analysis 已落库",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/risk-analysis/by-bid-record/{{bidRecordId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "risk-analysis",
                "by-bid-record",
                "{{bidRecordId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const result = pm.response.json();",
                  "pm.test('历史查询业务响应成功', function () {",
                  "    pm.expect(result.code).to.eql(200);",
                  "});",
                  "const records = result.data || [];",
                  "const analysisId = Number(pm.collectionVariables.get('analysisId'));",
                  "pm.test('本次分析结果已写入 risk_analysis', function () {",
                  "    pm.expect(records.some(function (record) { return Number(record.analysisId) === analysisId; })).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
