<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.TenderNoticeStatusHistoryMapper">

    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.entity.TenderNoticeStatusHistory">
        <id     column="history_id"   property="historyId"/>
        <result column="notice_id"    property="noticeId"/>
        <result column="from_status"  property="fromStatus"/>
        <result column="to_status"    property="toStatus"/>
        <result column="remark"       property="remark"/>
        <result column="created_at"   property="createdAt"/>
    </resultMap>

    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.TenderNoticeStatusHistory"
            useGeneratedKeys="true"
            keyProperty="historyId">
        INSERT INTO tender_notice_status_history
            (notice_id, from_status, to_status, remark)
        VALUES
            (#{noticeId}, #{fromStatus}, #{toStatus}, #{remark})
    </insert>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT history_id, notice_id, from_status, to_status, remark, created_at
        FROM tender_notice_status_history
        WHERE history_id = #{historyId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT history_id, notice_id, from_status, to_status, remark, created_at
        FROM tender_notice_status_history
    </select>

</mapper>
