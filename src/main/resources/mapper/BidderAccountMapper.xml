<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.BidderAccountMapper">

    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.entity.BidderAccount">
        <id     column="bidder_account_id" property="bidderAccountId"/>
        <result column="username"          property="username"/>
        <result column="password"          property="password"/>
        <result column="phone"             property="phone"/>
        <result column="display_name"      property="displayName"/>
        <result column="created_at"        property="createdAt"/>
    </resultMap>

    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.BidderAccount"
            useGeneratedKeys="true"
            keyProperty="bidderAccountId">
        INSERT INTO bidder_account
            (username, password, phone, display_name, created_at)
        VALUES
            (#{username}, #{password}, #{phone}, #{displayName}, #{createdAt})
    </insert>

    <update id="updateById"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.BidderAccount">
        UPDATE bidder_account
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="displayName != null">display_name = #{displayName},</if>
        </set>
        WHERE bidder_account_id = #{bidderAccountId}
    </update>

    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM bidder_account
        WHERE bidder_account_id = #{bidderAccountId}
    </delete>

    <select id="selectById" parameterType="java.lang.Long" resultMap="BaseResultMap">
        SELECT bidder_account_id, username, password, phone, display_name,
               created_at
        FROM bidder_account
        WHERE bidder_account_id = #{bidderAccountId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT bidder_account_id, username, password, phone, display_name,
               created_at
        FROM bidder_account
    </select>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM bidder_account
        WHERE bidder_account_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <select id="selectByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT bidder_account_id, username, password, phone, display_name,
               created_at
        FROM bidder_account
        WHERE bidder_account_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT bidder_account_id, username, password, phone, display_name,
               created_at
        FROM bidder_account
        WHERE username = #{username}
    </select>

</mapper>
