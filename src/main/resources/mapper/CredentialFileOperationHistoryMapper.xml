<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.CredentialFileOperationHistoryMapper">

    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.credentialfile.entity.CredentialFileOperationHistory">
        <id     column="history_id"          property="historyId"/>
        <result column="credential_file_id"  property="credentialFileId"/>
        <result column="operation"           property="operation"/>
        <result column="operator_type"       property="operatorType"/>
        <result column="operator_id"         property="operatorId"/>
        <result column="before_snapshot"     property="beforeSnapshot"/>
        <result column="after_snapshot"      property="afterSnapshot"/>
        <result column="remark"              property="remark"/>
        <result column="created_at"          property="createdAt"/>
    </resultMap>

    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.credentialfile.entity.CredentialFileOperationHistory"
            useGeneratedKeys="true"
            keyProperty="historyId">
        INSERT INTO credential_file_operation_history
            (credential_file_id, operation, operator_type, operator_id,
             before_snapshot, after_snapshot, remark, created_at)
        VALUES
            (#{credentialFileId}, #{operation}, #{operatorType}, #{operatorId},
             #{beforeSnapshot}, #{afterSnapshot}, #{remark}, #{createdAt})
    </insert>

    <select id="selectByCredentialFileId" resultMap="BaseResultMap">
        SELECT history_id, credential_file_id, operation, operator_type, operator_id,
               before_snapshot, after_snapshot, remark, created_at
        FROM credential_file_operation_history
        WHERE credential_file_id = #{credentialFileId}
        ORDER BY created_at DESC, history_id DESC
    </select>

</mapper>
