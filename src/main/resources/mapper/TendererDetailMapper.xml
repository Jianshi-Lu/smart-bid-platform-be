<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.TendererDetailMapper">

    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.entity.TendererDetail">
        <id     column="tenderer_id"      property="tendererId"/>
        <result column="tenderer_name"    property="tendererName"/>
        <result column="quote_price"      property="quotePrice"/>
        <result column="tenderer_contact" property="tendererContact"/>
        <result column="credentials"      property="credentials"/>
    </resultMap>

    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.TendererDetail"
            useGeneratedKeys="true"
            keyProperty="tendererId">
        INSERT INTO tenderer_detail
            (tenderer_name, quote_price, tenderer_contact, credentials)
        VALUES
            (#{tendererName}, #{quotePrice}, #{tendererContact}, #{credentials})
    </insert>

    <update id="updateById"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.TendererDetail">
        UPDATE tenderer_detail
        <set>
            <if test="tendererName != null">tenderer_name = #{tendererName},</if>
            <if test="quotePrice != null">quote_price = #{quotePrice},</if>
            <if test="tendererContact != null">tenderer_contact = #{tendererContact},</if>
            <if test="credentials != null">credentials = #{credentials},</if>
        </set>
        WHERE tenderer_id = #{tendererId}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM tenderer_detail
        WHERE tenderer_id = #{tendererId}
    </delete>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT tenderer_id, tenderer_name, quote_price, tenderer_contact, credentials
        FROM tenderer_detail
        WHERE tenderer_id = #{tendererId}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT tenderer_id, tenderer_name, quote_price, tenderer_contact, credentials
        FROM tenderer_detail
    </select>

    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM tenderer_detail
        WHERE tenderer_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <select id="selectByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT tenderer_id, tenderer_name, quote_price, tenderer_contact, credentials
        FROM tenderer_detail
        WHERE tenderer_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

</mapper>
