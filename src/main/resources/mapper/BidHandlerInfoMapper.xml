<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  ┌────────────────────────────────────────────────────────────────────┐
  │  BidHandlerInfoMapper.xml — 经办人 SQL 映射                       │
  │                                                                    │
  │  在整个开发链路中的位置：                                          │
  │   ① 数据库表（V1~V3 演进）                                        │
  │   ② Entity 层（BidHandlerInfo）                                   │
  │   ③ Mapper 接口（BidHandlerInfoMapper）                           │
  │   ④ Mapper XML（本文件，namespace 绑定接口）                       │
  │   ⑤ Service 层（注入 Mapper 接口调用）                            │
  │   ⑥ DTO 层                                                        │
  │   ⑦ Controller 层                                                 │
  │                                                                    │
  │  关键约定：                                                        │
  │   - namespace 必须等于 Mapper 接口全限定名（一个字符都不能错）    │
  │   - 每个 <insert> / <update> / <delete> / <select> 标签的         │
  │     id = Mapper 接口中的方法名                                    │
  │   - parameterType / resultMap 用全限定名（最稳）                  │
  │   - <resultMap> 定义 Java 字段 ↔ DB 列映射                       │
  └────────────────────────────────────────────────────────────────────┘
-->
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.BidHandlerInfoMapper">

    <!--
      BaseResultMap：Java 字段 ↔ DB 列映射
      即使 application.yml 配了 map-underscore-to-camel-case=true，
      这里仍显式声明，避免魔法规则带来的隐式行为。
    -->
    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.entity.BidHandlerInfo">
        <id     column="handler_id"      property="handlerId"/>
        <result column="handler_name"    property="handlerName"/>
        <result column="company_name"    property="companyName"/>
        <result column="department_name" property="departmentName"/>
    </resultMap>

    <!--
      插入：自增主键回填
      useGeneratedKeys="true" 让 MySQL 把自增 ID 写回 Java 对象的 handlerId 字段
      keyProperty 必须等于 Entity 中的 @TableId 字段名
    -->
    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.BidHandlerInfo"
            useGeneratedKeys="true"
            keyProperty="handlerId">
        INSERT INTO bid_handler_info (handler_name, company_name, department_name)
        VALUES (#{handlerName}, #{companyName}, #{departmentName})
    </insert>

    <!--
      按 ID 更新（PATCH 风格动态 SQL）：
      - 传入 entity 必须携带 handlerId（WHERE 条件）
      - 使用 <set> + <if> 实现 PATCH 语义：
        * 字段为 null → 不更新（保留 DB 原值）
        * 字段非 null → 更新
      - 配合 BidHandlerInfoUpdateRequest 使用（PATCH 请求体）
    -->
    <update id="updateById"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.BidHandlerInfo">
        UPDATE bid_handler_info
        <set>
            <if test="handlerName != null">handler_name = #{handlerName},</if>
            <if test="companyName != null">company_name = #{companyName},</if>
            <if test="departmentName != null">department_name = #{departmentName},</if>
        </set>
        WHERE handler_id    = #{handlerId}
    </update>

    <!--
      按 ID 删除：#{handlerId} 名称 = Mapper 接口方法参数名
    -->
    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM bid_handler_info
        WHERE handler_id = #{handlerId}
    </delete>

    <!--
      按 ID 查询：resultMap 引用上面定义的 BaseResultMap
    -->
    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT handler_id, handler_name, company_name, department_name
        FROM bid_handler_info
        WHERE handler_id = #{handlerId}
    </select>

    <!--
      查询全部（无参）：用 resultMap 复用
      数据量小时可直接用，数据量大时建议加分页（后续可加 PageHelper / Plus PaginationInnerInterceptor）
    -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT handler_id, handler_name, company_name, department_name
        FROM bid_handler_info
    </select>

    <!--
      批量删除（按主键列表）：用 <foreach> 拼接 IN 子句
      - 传 null / 空列表时，调用方 Service 拦截返 0，不进入 SQL
      - 列表中不存在的 ID 不会报错（IN 不会匹配到任何行，影响行数相应减少）
      - 单条 SQL 一次完成，由 MySQL 自动事务保证原子性
      - 配合 BatchDeleteRequest 使用（最大 500 条由 DTO @Size 限制）
    -->
    <delete id="deleteByIds" parameterType="java.util.List">
        DELETE FROM bid_handler_info
        WHERE handler_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <!--
      按主键列表查询（用于批量删除前置查询，知道哪些 ID 真的存在）
      - 用 <foreach> 拼接 IN 子句
      - 列表中不存在的 ID 不会出现在结果中（IN 自然不匹配）
      - 单次查询，PK 索引，毫秒级
      - 配合 deleteByIds 使用：先 selectByIds 拿存在行 → deleteByIds 删它们 → 返回删掉的行
      - 排序：DB 物理顺序（无 ORDER BY），最小实现
    -->
    <select id="selectByIds" parameterType="java.util.List" resultMap="BaseResultMap">
        SELECT handler_id, handler_name, company_name, department_name
        FROM bid_handler_info
        WHERE handler_id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>

</mapper>
