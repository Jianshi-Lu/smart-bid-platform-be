<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.lujianshi.bidwinningbackend.mapper.BidRecordOperationHistoryMapper">

    <resultMap id="BaseResultMap" type="io.gitee.lujianshi.bidwinningbackend.entity.bidrecord.BidRecordOperationHistory">
        <id     column="history_id"      property="historyId"/>
        <result column="bid_record_id"   property="bidRecordId"/>
        <result column="operation"       property="operation"/>
        <result column="operator_type"   property="operatorType"/>
        <result column="operator_id"     property="operatorId"/>
        <result column="before_snapshot" property="beforeSnapshot"/>
        <result column="after_snapshot"  property="afterSnapshot"/>
        <result column="remark"          property="remark"/>
        <result column="created_at"      property="createdAt"/>
    </resultMap>

    <insert id="insert"
            parameterType="io.gitee.lujianshi.bidwinningbackend.entity.bidrecord.BidRecordOperationHistory"
            useGeneratedKeys="true"
            keyProperty="historyId">
        INSERT INTO bid_record_operation_history
            (bid_record_id, operation, operator_type, operator_id,
             before_snapshot, after_snapshot, remark, created_at)
        VALUES
            (#{bidRecordId}, #{operation}, #{operatorType}, #{operatorId},
             #{beforeSnapshot}, #{afterSnapshot}, #{remark}, #{createdAt})
    </insert>

    <select id="selectByBidRecordId" resultMap="BaseResultMap">
        SELECT history_id, bid_record_id, operation, operator_type, operator_id,
               before_snapshot, after_snapshot, remark, created_at
        FROM bid_record_operation_history
        WHERE bid_record_id = #{bidRecordId}
        ORDER BY created_at DESC, history_id DESC
    </select>

</mapper>
