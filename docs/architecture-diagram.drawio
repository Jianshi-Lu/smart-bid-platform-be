        <mxCell id="1" parent="0" />
        <mxCell id="title" value="分层架构图 — Classic 4-Layer + 横切层" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="350" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;L1 表现层 (Presentation)&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 个通用业务 Controller + 2 个 credentialfile Controller + GlobalExceptionHandler&#xa;@RestController / JSON + multipart&#xa;HTTP 入参出参 (31 个显式业务端点)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
          <mxGeometry x="100" y="100" width="1200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;L2 业务层 (Application / Domain Logic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;全局 CRUD Service + credentialfile 模块 FileUploadService 编排&#xa;业务规则: UUID / 失败补偿 / bidNo 重试 / 状态机 / AI&#xa;模块内部依赖 FileStorage 与 FileChecksumCalculator 端口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=15;" parent="1" vertex="1">
          <mxGeometry x="100" y="220" width="1200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;L3 基础设施层 (Infrastructure)&lt;/b&gt;&lt;br&gt;&lt;br&gt;5 全局 Mapper + 2 credentialfile Mapper / 7 XML&#xa;LocalFileStorage (Java NIO)&#xa;Sha256FileChecksumCalculator (JDK MessageDigest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft:15;" parent="1" vertex="1">
          <mxGeometry x="100" y="340" width="1200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="&lt;b&gt;L4 数据层 (Data)&lt;/b&gt;&lt;br&gt;&lt;br&gt;MySQL 8 — 7 张业务表 (V1~V22)&#xa;Local / MinIO — bid-records/{bidRecordId}/batches/{uploadBatchId}/original/&#xa;上传完成后写入 credential_file，并在转换后回写 Markdown 路径" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" parent="1" vertex="1">
