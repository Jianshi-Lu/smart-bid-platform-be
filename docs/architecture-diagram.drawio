        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;类数量速查:&lt;/b&gt;&lt;br&gt;  L1: 5 Controller + 1 Handler = 6&lt;br&gt;  L2: 8 Service (含 BaseService 抽象基)&lt;br&gt;  Domain: 5 Entity + 1 Enum + 16 DTO = 22&lt;br&gt;  L3: 6 Mapper + 5 XML + 1 Base = 12&lt;br&gt;  L4: 5 张业务表&#xa;  Util: 3 (PromptFiller / ResourceSearcher / AsyncTaskManager)&#xa;  &lt;font color=&quot;#b85450&quot;&gt;&lt;b&gt;⚠ pom 死依赖:&lt;/b&gt;&lt;/font&gt;&lt;font color=&quot;#b85450&quot;&gt; deepseek starter + copy_down 1.1 — Java 代码零引用&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="720" y="780" width="580" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
