        <mxCell id="note" value="&lt;b&gt;依赖规则 (Dependency Rule):&lt;/b&gt;&lt;br&gt;  上层 → 下层 (L1→L2→L3→L4)&#xa;  横切层 → 业务层 (L2) 或 表现层 (L1)&#xa;  下层绝不依赖上层 (无循环依赖)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="100" y="780" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;数量速查:&lt;/b&gt;&lt;br&gt;  L1: 5 个通用业务 Controller + 2 个 credentialfile Controller + 1 Handler&lt;br&gt;  credentialfile 模块: Controller / DTO / Entity / Enum / Mapper / Service / Storage 等子包&lt;br&gt;  Mapper: 5 全局 + 2 credentialfile Mapper / BaseMapper / 7 XML&lt;br&gt;  Data: 7 张业务表 + Local / MinIO 文件存储" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="720" y="780" width="580" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
